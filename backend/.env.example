# =============================================
# Healora Backend — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit the actual .env file to git!
# =============================================

# MongoDB
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/healora

# JWT
JWT_SECRET=replace_with_a_long_random_secret_string

# Server
PORT=5000
FRONTEND_URL=http://localhost:3000

# AI APIs
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Email (Gmail App Password — not your real Gmail password)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your_app_specific_password
FROM_NAME=Healora Support
FROM_EMAIL=support@healora.com
